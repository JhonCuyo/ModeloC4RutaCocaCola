@startuml
title <size:24>Dinámico - Reservar y pagar un tour (HU-02 y HU-03)</size>\n<size:24>Reservar y pagar un tour</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Software System,Externo", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Base de datos", $bgColor="#0e7d73", $borderColor="#095750", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#0b3d62", $borderColor="#072a44", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#0e7d73", $borderColor="#095750", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#124161", $fontColor="#124161", $shadowing="", $borderStyle="solid")

System_Boundary("RutaColca_boundary", "RutaColca", $tags="Software System") {
  Container(RutaColca.Webdelturista, "Web del turista", $techn="React (SPA)", $descr="Permite buscar tours, elegir una salida, registrar el boleto turístico y pagar. SPA = aplicación de una sola página.", $tags="Container", $link="")
  Container(RutaColca.APIdeRutaColca, "API de RutaColca", $techn="Java 21, Spring Boot", $descr="Concentra las reglas de negocio: tours, cupos, reservas, validación del boleto, cobro y avisos.", $tags="Container", $link="")
  ContainerDb(RutaColca.Basededatos, "Base de datos", $techn="PostgreSQL 16", $descr="Guarda agencias, tours, salidas, cupos y reservas. No guarda datos de tarjetas.", $tags="Container,Base de datos", $link="")
}

Person(Turista, "Turista", $descr="Visitante que busca tours del valle del Colca, reserva una salida y paga en línea.", $tags="Person", $link="")
Person(Guíadeturismo, "Guía de turismo", $descr="Conduce al grupo en la salida; recibe el itinerario y la lista del grupo por WhatsApp, no usa la plataforma.", $tags="Person", $link="")
System(Pasareladepagos, "Pasarela de pagos", $descr="Servicio externo que procesa pagos con tarjeta o billetera móvil; guarda los datos de tarjeta.", $tags="Software System,Externo", $link="")
System(WhatsAppBusiness, "WhatsApp Business", $descr="Servicio externo de mensajería que entrega mensajes a los guías.", $tags="Software System,Externo", $link="")
System(SistemadeAUTOCOLCA, "Sistema de AUTOCOLCA", $descr="Sistema externo que emite y valida el boleto turístico del Colca (supuesto didáctico).", $tags="Software System,Externo", $link="")

Rel(Turista, RutaColca.Webdelturista, "1: Elige la salida, escribe su boleto y pulsa pagar", $techn="HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.Webdelturista, RutaColca.APIdeRutaColca, "2: Envía la reserva con el número de boleto", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, RutaColca.Basededatos, "3: Verifica y retiene el cupo de la salida", $techn="JDBC", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, SistemadeAUTOCOLCA, "4: Valida el número de boleto turístico", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, Pasareladepagos, "5: Cobra el monto de la reserva", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, RutaColca.Basededatos, "6: Guarda la reserva confirmada", $techn="JDBC", $tags="Relationship", $link="")
Rel(RutaColca.APIdeRutaColca, WhatsAppBusiness, "7: Solicita enviar el itinerario de la salida", $techn="JSON/HTTPS", $tags="Relationship", $link="")
Rel(WhatsAppBusiness, Guíadeturismo, "8: Entrega el itinerario y la lista actualizada del grupo", $techn="WhatsApp", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml